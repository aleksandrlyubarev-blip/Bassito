# ── Telegram ─────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF...
ALLOWED_TELEGRAM_IDS=123456789  # Comma-separated for multiple users

# ── AI API Keys ──────────────────────────────────────────────────
XAI_API_KEY=xai-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...                    # CV parsing + job ranking

# ── Google Drive ─────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# ── CTA5 ─────────────────────────────────────────────────────────
CTA5_INSTALL_DIR=C:\Program Files\Reallusion\Cartoon Animator 5
CTA5_SCRIPT_WATCH_DIR=C:\Users\Public\Documents\Reallusion\CTA5\Scripts
CTA5_RENDER_TIMEOUT_MINUTES=30

# ── Job Queue ────────────────────────────────────────────────────
MAX_QUEUE_SIZE=10
JOB_TIMEOUT_MINUTES=60

# ── Local M5 image-to-video (/generate_local, Apple Silicon) ─────
# Ideogram 4 (nf4 recommended for 24 GB) -> I2V backend, run on a MacBook Pro M5 Pro.
BASSITO_IDEOGRAM4_WEIGHTS=/Models/ideogram-4-nf4   # unpacked Ideogram 4 checkpoint
BASSITO_IDEOGRAM4_QUANT=nf4                         # nf4 (24 GB) | fp8
# I2V backend weights (set the one(s) you use; selection is memory-aware):
BASSITO_WAN21_WEIGHTS=/Models/wan2.1-14b-svdquant   # Wan 2.1 14B, 6-bit SVDQuant (~16 GB)
# BASSITO_LTXVIDEO_WEIGHTS=/Models/ltx-video-2.3     # LTX-Video, native Apple MLX
# BASSITO_HUNYUAN15_WEIGHTS=/Models/hunyuan-video-1.5
# BASSITO_M5_I2V_BACKEND=                            # force a backend by name, else auto
BASSITO_M5_TOTAL_GB=24             # unified memory size
BASSITO_M5_OS_RESERVED_GB=5        # reserved by macOS + host app
BASSITO_M5_FRAMES=81               # 49 | 81 | 129
BASSITO_M5_FPS=16

# ── Job Search (/find_boost) ─────────────────────────────────────
BASSITO_USE_LINKEDIN=false         # opt-in: LinkedIn guest scraper (ToS risk, periodic breakage)
BASSITO_JOBS_DIGEST_HOUR=9         # daily digest hour, Asia/Jerusalem
BASSITO_JOBS_MIN_SCORE=70          # threshold 0-100 for the daily digest
